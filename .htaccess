# ════════════════════════════════
#  NASME GYM — Apache Configuration
#  File: .htaccess (backend root)
#  Used on XAMPP. Railway uses nginx.conf.
# ════════════════════════════════

Options -Indexes
RewriteEngine On

# Do NOT use Access-Control-Allow-Origin: *
# Credentialed fetch() from Vercel requires a real origin
# plus Access-Control-Allow-Credentials (set in api/helpers.php).

# Handle OPTIONS preflight
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=204,L]

# Block direct access to helpers.php and db.php
RewriteRule ^api/helpers\.php$ - [F,L]
RewriteRule ^db\.php$ - [F,L]
